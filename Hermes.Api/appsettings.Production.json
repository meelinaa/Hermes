{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information"
    },
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Formatting.Compact",
      "Serilog.Enrichers.Span"
    ],
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "formatter": "Serilog.Formatting.Compact.RenderedCompactJsonFormatter, Serilog.Formatting.Compact"
        }
      }
    ],
    "Enrich": [ "FromLogContext" ]
  },
  "OpenApi": {
    "MapInProduction": true,
    "DocumentationApiKey": ""
  },
  "OpenTelemetry": {
    "Enabled": false,
    "ServiceName": "Hermes.Api"
  },
  "Jwt": {
    "SigningKey": "DEV_ONLY_LOCAL_SIGNING_KEY_MIN_32_CHARS_USE_USER_SECRETS_OR_ENV_IN_SHARED_ENVIRONMENTS!"
  },
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Port=3308;Database=hermes;User=root;Password=password1234!;"
  }
}
