{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      }
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5269",
      "https://localhost:7016"
    ]
  },
  "Jwt": {
    "Issuer": "Hermes",
    "Audience": "Hermes.Api",
    "AccessTokenMinutes": 60,
    "RefreshTokenDays": 14,
    "SigningKey": ""
  },
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "HermesSite": {
    "PublicBaseUrl": "https://hermes.de",
    "SupportEmail": "support@hermes.de"
  },
  "OpenTelemetry": {
    "Enabled": false,
    "ServiceName": "Hermes.Api",
    "OtlpEndpoint": "",
    "OtlpHeaders": ""
  },
  "OpenApi": {
    "DocumentName": "v1",
    "RoutePattern": "openapi/{documentName}.json",
    "DocumentationPathPrefix": "/openapi",
    "MapInProduction": false,
    "DocumentationApiKey": "",
    "DocumentationApiKeyHeader": "X-Hermes-Documentation-Key"
  }
}
