{
  "Newsletter": {
    "SchedulingNote": "Cron.Minutely. Each news table row = separate e-mail (never combined per user). Same SendAtTime on multiple rows → multiple sends. Idempotency only blocks duplicate (UserId, NewsId, same minute).",
    "TimeZoneId": "Europe/Berlin"
  },
  "ConnectionStrings": {
    "DefaultConnection": "",
    "Redis": "localhost:6379"
  },
  "Email": {
    "Host": "localhost",
    "Port": 1025,
    "EnableSsl": false,
    "Username": "",
    "Password": "",
    "DefaultFromAddress": "hermes@test.com",
    "DefaultFromName": "Hermes",
    "DefaultReplyToAddress": "noreply@test.com",
    "DefaultReplyToName": "No Reply",
    "XMailer": "Hermes/1.0"
  },
  "HermesSite": {
    "PublicBaseUrl": "https://hermes.de",
    "SupportEmail": "support@hermes.de"
  },
  "Security": {
    "HashEmailVerificationCodes": true
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Enrichers.Span"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      }
    ]
  },
  "OpenTelemetry": {
    "Enabled": false,
    "ServiceName": "Hermes.Worker",
    "OtlpEndpoint": "",
    "OtlpHeaders": ""
  },
  "NewsDataIo": {
    "Key": ""
  }
}
