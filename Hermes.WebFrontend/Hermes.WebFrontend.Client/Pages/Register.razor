@page "/register"
@layout AuthLayout
@rendermode @(new InteractiveWebAssemblyRenderMode(prerender: false))
@using Hermes.WebFrontend.Client.Components.Auth
@using Hermes.WebFrontend.Client.ViewModels
@inject RegisterViewModel Model

<PageTitle>Registrieren — Hermes</PageTitle>

<div class="auth-split">
    <div class="auth-split__left">
        <div class="hermes-auth-card">
            <div class="hermes-auth-brand-row">
                <HermesBrand />
            </div>
            <h1 class="hermes-auth-title">Registrieren</h1>
            <p class="hermes-auth-subtitle">Neues Konto für Hermes anlegen.</p>

            <div class="hermes-auth-fields">
                <div class="hermes-auth-field">
                    <label class="hermes-auth-label" for="reg-username">Benutzername</label>
                    <input id="reg-username" class="hermes-auth-input" type="text" autocomplete="username"
                           placeholder="Benutzername" @bind="Model.Username" @bind:event="oninput" />
                </div>
                <div class="hermes-auth-field">
                    <label class="hermes-auth-label" for="reg-email">E-Mail</label>
                    <input id="reg-email" class="hermes-auth-input" type="email" autocomplete="email"
                           placeholder="name@beispiel.de" @bind="Model.Email" @bind:event="oninput" />
                    @if (Model.ShowEmailFormatError)
                    {
                        <p class="hermes-reg-hint hermes-reg-hint--error" role="status">Bitte eine gültige E-Mail-Adresse eingeben.</p>
                    }
                </div>
                <div class="hermes-auth-field">
                    <label class="hermes-auth-label" for="reg-password">Passwort</label>
                    <input id="reg-password" class="hermes-auth-input" type="password" autocomplete="new-password"
                           placeholder="Passwort" @bind="Model.Password" @bind:event="oninput" />
                    @if (Model.Password.Length > 0)
                    {
                        <ul class="hermes-reg-rules" aria-label="Passwortanforderungen">
                            <li class="@RegisterViewModel.RuleClass(Model.PasswordLenOk)">mind. 8 Zeichen</li>
                            <li class="@RegisterViewModel.RuleClass(Model.PasswordCaseOk)">Groß- und Kleinbuchstaben</li>
                            <li class="@RegisterViewModel.RuleClass(Model.PasswordDigitOk)">mindestens eine Zahl</li>
                            <li class="@RegisterViewModel.RuleClass(Model.PasswordSymbolOk)">mindestens ein Symbol</li>
                        </ul>
                    }
                </div>
            </div>

            @if (!string.IsNullOrEmpty(Model.RegisterError))
            {
                <p class="hermes-auth-error" role="alert">@Model.RegisterError</p>
            }

            <button type="button" class="hermes-auth-submit" disabled="@(!Model.CanRegister || Model.IsBusy)" @onclick="OnRegisterClick">Registrieren</button>

            <p class="hermes-auth-footer mt-4 mb-0">
                <a href="/login">Zurück zur Anmeldung</a>
            </p>
        </div>
    </div>
    <AuthSwissPoster />
</div>

@code {
    protected override async Task OnInitializedAsync()
    {
        await Model.InitializeAsync();
    }

    private async Task OnRegisterClick()
    {
        await Model.RegisterAsync();
    }
}
