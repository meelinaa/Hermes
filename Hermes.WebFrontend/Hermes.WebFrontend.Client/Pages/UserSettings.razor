@page "/user-settings"
@layout AppHomeLayout
@attribute [Authorize]
@rendermode @(new InteractiveWebAssemblyRenderMode(prerender: false))
@using Hermes.WebFrontend.Client.Components.UserSettings
@using Hermes.WebFrontend.Client.ViewModels
@implements IAsyncDisposable
@inject UserSettingsViewModel Model

<PageTitle>Profil — Hermes</PageTitle>

<div class="home-content @((Model.ShowVerificationModal || Model.ShowDeleteAccountModal) ? " home-content--modal-open" : "")">
    <h2 class="home-welcome">Profil &amp; Sicherheit</h2>

    <section class="home-panel user-profile-panel">
        <h3 class="user-profile-title">Persönliche Daten und Sicherheit</h3>

        <ProfileInfoSection Model="Model" />
        <PasswordChangeSection Model="Model" />

        @if (!string.IsNullOrEmpty(Model.ProfileFeedback))
        {
            <p class="user-profile-feedback" role="status">@Model.ProfileFeedback</p>
        }

        <div class="user-profile-actions">
            <button type="button"
                    class="@Model.ProfileSubmitButtonClass"
                    disabled="@Model.ProfileBusy"
                    aria-busy="@Model.ProfileBusy"
                    aria-disabled="@Model.ProfileSubmitAriaDisabled"
                    @onclick="() => Model.UpdateProfileAsync()">
                @(Model.ProfileBusy ? "Speichern…" : "Profil aktualisieren")
            </button>
        </div>
    </section>

    <div class="user-profile-delete-account">
        <button type="button"
                class="user-profile-delete-account__btn"
                disabled="@(Model.ProfileUserId is null || Model.DeleteAccountBusy)"
                @onclick="Model.OpenDeleteAccountModal">
            Benutzer löschen
        </button>
    </div>
</div>

<EmailVerificationModal Model="Model" />
<DeleteAccountModal Model="Model" />

@code {
    protected override async Task OnInitializedAsync()
    {
        Model.StateChanged += OnModelStateChanged;
        await Model.InitializeAsync();
    }

    private void OnModelStateChanged() => InvokeAsync(StateHasChanged);

    public async ValueTask DisposeAsync()
    {
        Model.StateChanged -= OnModelStateChanged;
        await Model.DisposeAsync();
    }
}
