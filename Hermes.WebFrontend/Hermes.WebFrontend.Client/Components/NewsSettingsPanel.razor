@using Hermes.WebFrontend.Client.ApiModels
@using Hermes.WebFrontend.Client.Components.News
@using Hermes.WebFrontend.Client.ViewModels
@inject NewsSettingsViewModel Model

<div class="news-settings-panel">
    @if (!Model.ShowForm)
    {
        <NewsFilterToolbar Model="Model" />

        @if (Model.Loading)
        {
            <NewsCardSkeleton Count="3" />
        }
        else if (!string.IsNullOrEmpty(Model.LoadError))
        {
            <p class="user-profile-feedback" role="alert">@Model.LoadError</p>
        }
        else if (Model.Items.Count == 0)
        {
            @if (Model.HasActiveFilters)
            {
                <p class="news-settings-muted">Keine Einträge für die aktuellen Filter.</p>
            }
            else
            {
                <p class="news-settings-muted">Noch keine News-Konfiguration. Tippe auf <strong>+</strong>, um eine anzulegen.</p>
            }
        }
        else
        {
            <ul class="news-settings-list">
                @foreach (NewsSubscriptionDto n in Model.Items)
                {
                    <li class="news-settings-card">
                        <div class="news-settings-card-head">
                            <h3 class="news-settings-card-title">@NewsSettingsViewModel.TitleFor(n)</h3>
                            <div class="news-settings-card-actions">
                                <label class="hermes-toggle-switch @(Model.DeletingId.HasValue || Model.TogglingId == n.Id ? "hermes-toggle-switch--disabled" : string.Empty)">
                                    <input type="checkbox"
                                           class="hermes-toggle-switch__input"
                                           role="switch"
                                           aria-label="E-Mail-Versand umschalten"
                                           checked="@n.IsEnabled"
                                           disabled="@(Model.DeletingId.HasValue || Model.TogglingId == n.Id)"
                                           @onchange="e => OnToggleEnabled(n, e)" />
                                    <span class="hermes-toggle-switch__track" aria-hidden="true"></span>
                                </label>
                                <button type="button" class="news-settings-icon news-settings-icon--danger" title="Löschen"
                                        disabled="@(Model.DeletingId.HasValue || Model.TogglingId == n.Id)" @onclick="() => Model.DeleteAsync(n)">
                                    <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="currentColor" d="M9 3v1H4v2h1v13a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V6h1V4h-5V3H9m0 5h2v9H9V8m4 0h2v9h-2V8Z"/></svg>
                                </button>
                                <button type="button" class="news-settings-icon news-settings-icon--primary" title="Bearbeiten"
                                        disabled="@(Model.DeletingId.HasValue || Model.TogglingId == n.Id)"
                                        @onclick="() => Model.StartEdit(n)">
                                    <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="currentColor" d="M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25M20.71 7.04a1 1 0 0 0 0-1.41l-2.34-2.34a1 1 0 0 0-1.41 0l-1.83 1.83 3.75 3.75 1.83-1.83Z"/></svg>
                                </button>
                            </div>
                        </div>
                        <dl class="news-settings-dl">
                            <div><dt>Schlagworte</dt><dd>@NewsSettingsViewModel.FormatKeywords(n)</dd></div>
                            <div><dt>Kategorien</dt><dd>@NewsSettingsViewModel.FormatCategories(n)</dd></div>
                            <div><dt>Sprachen</dt><dd>@NewsSettingsViewModel.FormatLanguages(n)</dd></div>
                            <div><dt>Länder</dt><dd>@NewsSettingsViewModel.FormatCountries(n)</dd></div>
                            <div><dt>Sende-Tage</dt><dd>@NewsSettingsViewModel.FormatWeekdays(n)</dd></div>
                            <div><dt>Sende-Zeitpunkt</dt><dd>@NewsSettingsViewModel.FormatTimes(n)</dd></div>
                        </dl>
                    </li>
                }
            </ul>

            @if (Model.TotalPages is int tp && Model.TotalCount is int tc)
            {
                <div class="news-settings-pagination" role="navigation" aria-label="Seiten">
                    <button type="button" class="news-settings-btn" disabled="@(Model.CurrentPage <= 1 || Model.DeletingId.HasValue || Model.TogglingId.HasValue)" @onclick="() => Model.PrevPageAsync()">Zurück</button>
                    <span class="news-settings-pageinfo">Seite @Model.CurrentPage von @tp (@tc Einträge)</span>
                    <button type="button" class="news-settings-btn" disabled="@(!Model.HasNextPage || Model.DeletingId.HasValue || Model.TogglingId.HasValue)" @onclick="() => Model.NextPageAsync()">Weiter</button>
                </div>
            }
            else if (Model.HasNextPage || Model.CurrentPage > 1)
            {
                <div class="news-settings-pagination" role="navigation" aria-label="Seiten">
                    <button type="button" class="news-settings-btn" disabled="@(Model.CurrentPage <= 1 || Model.DeletingId.HasValue || Model.TogglingId.HasValue)" @onclick="() => Model.PrevPageAsync()">Zurück</button>
                    <span class="news-settings-pageinfo">@(Model.TotalCount is int t ? $"{t} Einträge · " : "")Seite @Model.CurrentPage</span>
                    <button type="button" class="news-settings-btn" disabled="@(!Model.HasNextPage || Model.DeletingId.HasValue || Model.TogglingId.HasValue)" @onclick="() => Model.NextPageAsync()">Weiter</button>
                </div>
            }
        }
    }
    else
    {
        <NewsSubscriptionEditor Model="Model" />
    }
</div>

@code {
    [Parameter] public bool StartInCreateMode { get; set; }

    protected override async Task OnInitializedAsync()
    {
        Model.StateChanged += OnModelStateChanged;
        await Model.InitializeAsync(StartInCreateMode);
    }

    private void OnModelStateChanged() => InvokeAsync(StateHasChanged);

    private async Task OnToggleEnabled(NewsSubscriptionDto n, ChangeEventArgs e)
    {
        if (e.Value is bool targetEnabled)
            await Model.ToggleEnabledAsync(n, targetEnabled);
    }
}
