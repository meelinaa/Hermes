@typeparam TItem where TItem : notnull

<div class="news-sub-field">
    <span class="news-sub-label">@Label</span>
    <details class="news-ms">
        <summary class="news-ms-summary">@SummaryText</summary>
        <div class="news-ms-body">
            <div class="news-ms-search">
                <input type="search" class="form-control form-control-sm" placeholder="@Placeholder"
                       aria-label="@Placeholder" @bind="searchQuery" @bind:event="oninput" />
            </div>
            @foreach (TItem item in VisibleItems)
            {
                <label class="news-ms-row">
                    <input type="checkbox" checked="@SelectedItems.Contains(item)"
                           @onchange="e => OnCheckboxChanged(item, e)" />
                    <span>@GetDisplayName(item)</span>
                </label>
            }
        </div>
    </details>
</div>

@code {
    [Parameter, EditorRequired] public string Label { get; set; } = string.Empty;
    [Parameter] public string Placeholder { get; set; } = "Durchsuchen…";
    [Parameter, EditorRequired] public IReadOnlyList<TItem> AllItems { get; set; } = [];
    [Parameter, EditorRequired] public HashSet<TItem> SelectedItems { get; set; } = [];
    [Parameter, EditorRequired] public Func<TItem, string> GetDisplayName { get; set; } = null!;
    [Parameter, EditorRequired] public Action<TItem, bool> OnToggle { get; set; } = null!;
    [Parameter, EditorRequired] public string SummaryText { get; set; } = string.Empty;

    private string searchQuery = string.Empty;

    private IEnumerable<TItem> VisibleItems =>
        AllItems.Where(item => MatchesSearch(searchQuery, item.ToString() ?? string.Empty, GetDisplayName(item)));

    private static bool MatchesSearch(string query, string rawName, string displayName)
    {
        if (string.IsNullOrWhiteSpace(query))
            return true;
        string q = query.Trim();
        return displayName.Contains(q, StringComparison.CurrentCultureIgnoreCase)
               || rawName.Contains(q, StringComparison.OrdinalIgnoreCase);
    }

    private void OnCheckboxChanged(TItem item, ChangeEventArgs e)
    {
        if (e.Value is bool isChecked)
            OnToggle(item, isChecked);
    }
}
