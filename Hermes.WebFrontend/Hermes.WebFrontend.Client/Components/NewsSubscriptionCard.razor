@using Hermes.WebFrontend.Client.ApiModels
@using Hermes.WebFrontend.Client.ApiModels.Enums
@using Hermes.WebFrontend.Client.Components.News
@using Hermes.WebFrontend.Client.Enums
@using Hermes.WebFrontend.Client.ViewModels
@inject NewsSubscriptionCardViewModel Model

<section class="news-sub">
    @if (ShowBackButton)
    {
        <div class="news-sub-back">
            <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="BackToList">← Zurück zur Übersicht</button>
        </div>
    }
    <div class="news-sub-head">
        <h3 class="news-sub-title">@(Model.EditingLabel)</h3>
        <span class="home-bell-wrap" aria-hidden="true">
            <svg class="home-bell" viewBox="0 0 24 24" width="22" height="22"><path fill="currentColor" d="M12 22a2 2 0 0 0 2-2h-4a2 2 0 0 0 2 2Zm6-6V11a6 6 0 1 0-12 0v5l-2 2v1h16v-1l-2-2Z"/></svg>
            <span class="home-bell-dot"></span>
        </span>
    </div>

    <div class="news-sub-field">
        <label class="news-sub-label" for="ns-keywords">Schlagworte</label>
        <input id="ns-keywords" class="form-control news-sub-input" type="text"
               placeholder="z. B. Klima, Tech, Politik" @bind="Model.KeywordsRaw" @bind:event="oninput" />
        <p class="news-sub-hint">Mehrere Begriffe durch <strong>Komma</strong> trennen.</p>
    </div>

    <MultiSelectFilterDropdown TItem="NewsCategory"
                               Label="Nachrichten-Kategorien"
                               Placeholder="Kategorien durchsuchen…"
                               AllItems="AllNewsCategories"
                               SelectedItems="Model.SelectedCategories"
                               GetDisplayName="NewsEnumGermanDisplayConstants.CategoryDe"
                               OnToggle="Model.ToggleCategory"
                               SummaryText="@Model.CategorySummaryText" />

    <MultiSelectFilterDropdown TItem="Language"
                               Label="Sprachen"
                               Placeholder="Sprachen durchsuchen…"
                               AllItems="AllLanguages"
                               SelectedItems="Model.SelectedLanguages"
                               GetDisplayName="NewsEnumGermanDisplayConstants.LanguageDe"
                               OnToggle="Model.ToggleLanguage"
                               SummaryText="@Model.LanguageSummaryText" />

    <MultiSelectFilterDropdown TItem="Country"
                               Label="Länder"
                               Placeholder="Länder durchsuchen…"
                               AllItems="AllCountries"
                               SelectedItems="Model.SelectedCountries"
                               GetDisplayName="NewsEnumGermanDisplayConstants.CountryDe"
                               OnToggle="Model.ToggleCountry"
                               SummaryText="@Model.CountrySummaryText" />

    <div class="news-sub-field">
        <span class="news-sub-label">E-Mail-Versand</span>
        <div class="hermes-toggle-switch-row">
            <label class="hermes-toggle-switch @(Model.IsSaving ? "hermes-toggle-switch--disabled" : string.Empty)">
                <input class="hermes-toggle-switch__input"
                       type="checkbox"
                       role="switch"
                       id="ns-enabled"
                       aria-describedby="ns-enabled-caption"
                       disabled="@Model.IsSaving"
                       @bind="Model.IsEnabled" />
                <span class="hermes-toggle-switch__track" aria-hidden="true"></span>
            </label>
            <span class="hermes-toggle-switch-caption" id="ns-enabled-caption">Newsletter für diese Konfiguration senden</span>
        </div>
        <p class="news-sub-hint">Ausgeschaltet bleibt die Konfiguration erhalten; es werden nur keine E-Mails mehr verschickt.</p>
    </div>

    <WeekdayPicker DayActive="Model.DayActive" OnToggleDay="Model.ToggleDay" />
    <TimeSlotPicker SharedTimes="Model.SharedTimes"
                    OnSetTime="Model.SetSharedTime"
                    OnAddTimeSlot="Model.AddSharedTimeSlot"
                    OnRemoveTimeSlot="Model.RemoveSharedTimeSlot" />

    @if (!string.IsNullOrEmpty(Model.NewsFeedback))
    {
        <p class="user-profile-feedback" role="status">@Model.NewsFeedback</p>
    }

    <div class="user-profile-actions">
        <button type="button" class="user-profile-submit" disabled="@Model.IsSaving" @onclick="OnSave">News-Konfiguration speichern</button>
    </div>
</section>

@code {
    private static readonly NewsCategory[] AllNewsCategories = Enum.GetValues<NewsCategory>().ToArray();
    private static readonly Language[] AllLanguages = Enum.GetValues<Language>().ToArray();
    private static readonly Country[] AllCountries = Enum.GetValues<Country>().ToArray();

    [Parameter] public NewsSubscriptionDto? InitialModel { get; set; }
    [Parameter] public bool ShowBackButton { get; set; }
    [Parameter] public EventCallback<bool> OnReturnToList { get; set; }

    protected override void OnInitialized()
    {
        Model.StateChanged += OnModelStateChanged;
    }

    protected override void OnParametersSet()
    {
        Model.ApplyInitialModel(InitialModel);
    }

    private void OnModelStateChanged() => InvokeAsync(StateHasChanged);

    private async Task BackToList()
    {
        if (OnReturnToList.HasDelegate)
            await OnReturnToList.InvokeAsync(false);
    }

    private async Task OnSave()
    {
        var (success, _) = await Model.SaveNewsConfigurationAsync();
        if (success && OnReturnToList.HasDelegate)
            await OnReturnToList.InvokeAsync(true);
    }
}
