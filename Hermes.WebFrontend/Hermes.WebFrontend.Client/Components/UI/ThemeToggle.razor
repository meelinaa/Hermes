@using Hermes.WebFrontend.Client.Services.Theme
@implements IDisposable
@inject IThemeService Theme

<button type="button"
        class="hermes-theme-toggle @Class"
        title="@ThemeTooltip"
        aria-label="@ThemeTooltip"
        @onclick="ToggleThemeAsync">
    <span class="hermes-theme-toggle__icon" aria-hidden="true">
        @if (Theme.CurrentTheme == AppTheme.Dark)
        {
            <!-- Moon icon -->
            <svg viewBox="0 0 24 24" width="18" height="18"><path fill="currentColor" d="M12 3a9 9 0 1 0 9 9c0-.46-.04-.92-.1-1.36a5.389 5.389 0 0 1-4.4 2.26 5.403 5.403 0 0 1-3.14-9.8c-.44-.06-.9-.1-1.36-.1Z"/></svg>
        }
        else if (Theme.CurrentTheme == AppTheme.Light)
        {
            <!-- Sun icon -->
            <svg viewBox="0 0 24 24" width="18" height="18"><path fill="currentColor" d="M12 7c-2.76 0-5 2.24-5 5s2.24 5 5 5 5-2.24 5-5-2.24-5-5-5zM2 13h2c.55 0 1-.45 1-1s-.45-1-1-1H2c-.55 0-1 .45-1 1s.45 1 1 1zm18 0h2c.55 0 1-.45 1-1s-.45-1-1-1h-2c-.55 0-1 .45-1 1s.45 1 1 1zM11 2v2c0 .55.45 1 1 1s1-.45 1-1V2c0-.55-.45-1-1-1s-1 .45-1 1zm0 18v2c0 .55.45 1 1 1s1-.45 1-1v-2c0-.55-.45-1-1-1s-1 .45-1 1zM5.99 4.58a.996.996 0 0 0-1.41 0 .996.996 0 0 0 0 1.41l1.06 1.06c.39.39 1.03.39 1.41 0s.39-1.03 0-1.41L5.99 4.58zm12.37 12.37a.996.996 0 0 0-1.41 0 .996.996 0 0 0 0 1.41l1.06 1.06c.39.39 1.03.39 1.41 0a.996.996 0 0 0 0-1.41l-1.06-1.06zm1.06-10.96a.996.996 0 0 0-1.41-1.41l-1.06 1.06c-.39.39-.39 1.03 0 1.41s1.03.39 1.41 0l1.06-1.06zM7.05 18.36a.996.996 0 0 0-1.41-1.41l-1.06 1.06c-.39.39-.39 1.03 0 1.41s1.03.39 1.41 0l1.06-1.06z"/></svg>
        }
        else
        {
            <!-- System Monitor icon -->
            <svg viewBox="0 0 24 24" width="18" height="18"><path fill="currentColor" d="M21 2H3c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h7v2H8v2h8v-2h-2v-2h7c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2zm0 14H3V4h18v12z"/></svg>
        }
    </span>
    @if (ShowLabel)
    {
        <span class="hermes-theme-toggle__label">@ThemeLabel</span>
    }
</button>

@code {
    /// <summary>Gets or sets whether to display a text label alongside the theme icon.</summary>
    [Parameter] public bool ShowLabel { get; set; } = false;

    /// <summary>Gets or sets additional custom CSS classes.</summary>
    [Parameter] public string Class { get; set; } = string.Empty;

    private string ThemeLabel => Theme.CurrentTheme switch
    {
        AppTheme.Light => "Hell",
        AppTheme.Dark => "Dunkel",
        _ => "System"
    };

    private string ThemeTooltip => $"Design: {ThemeLabel} (Klicken zum Wechseln)";

    /// <summary>Initializes theme state and subscribes to theme changes.</summary>
    protected override async Task OnInitializedAsync()
    {
        Theme.ThemeChanged += OnThemeChanged;
        await Theme.InitializeAsync();
    }

    /// <summary>Cycles to the next available theme in sequence.</summary>
    private async Task ToggleThemeAsync()
    {
        await Theme.CycleThemeAsync();
    }

    private void OnThemeChanged() => InvokeAsync(StateHasChanged);

    /// <summary>Unsubscribes from theme change events.</summary>
    public void Dispose()
    {
        Theme.ThemeChanged -= OnThemeChanged;
    }
}
