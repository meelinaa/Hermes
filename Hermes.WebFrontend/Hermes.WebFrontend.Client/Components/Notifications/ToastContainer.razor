@using Hermes.WebFrontend.Client.Services.Notifications
@implements IDisposable
@inject IToastNotificationService ToastService

<aside class="toast-container" aria-live="polite" aria-atomic="true">
    @foreach (ToastMessage toast in ToastService.Toasts)
    {
        <div class="toast-item toast-item--@toast.Level.ToString().ToLowerInvariant()" role="alert">
            <div class="toast-item__icon" aria-hidden="true">
                @switch (toast.Level)
                {
                    case ToastNotificationLevel.Success:
                        <svg viewBox="0 0 24 24" width="20" height="20"><path fill="currentColor" d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"/></svg>
                        break;
                    case ToastNotificationLevel.Error:
                        <svg viewBox="0 0 24 24" width="20" height="20"><path fill="currentColor" d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-2h2v2zm0-4h-2V7h2v6z"/></svg>
                        break;
                    case ToastNotificationLevel.Warning:
                        <svg viewBox="0 0 24 24" width="20" height="20"><path fill="currentColor" d="M1 21h22L12 2 1 21zm12-3h-2v-2h2v2zm0-4h-2v-4h2v4z"/></svg>
                        break;
                    default:
                        <svg viewBox="0 0 24 24" width="20" height="20"><path fill="currentColor" d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-6h2v6zm0-8h-2V7h2v2z"/></svg>
                        break;
                }
            </div>
            <div class="toast-item__content">
                @if (!string.IsNullOrEmpty(toast.Title))
                {
                    <h4 class="toast-item__title">@toast.Title</h4>
                }
                <p class="toast-item__message">@toast.Message</p>
            </div>
            <button type="button" class="toast-item__close" @onclick="() => ToastService.Dismiss(toast.Id)" aria-label="Benachrichtigung schließen">
                <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path fill="currentColor" d="M19 6.41 17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12 19 6.41z"/></svg>
            </button>
            @if (toast.DurationMs > 0)
            {
                <div class="toast-item__progress-track" aria-hidden="true">
                    <div class="toast-item__progress-bar" style="animation-duration: @(toast.DurationMs)ms;"></div>
                </div>
            }
        </div>
    }
</aside>

@code {
    protected override void OnInitialized()
    {
        ToastService.OnChange += OnToastsChanged;
    }

    private void OnToastsChanged() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        ToastService.OnChange -= OnToastsChanged;
    }
}
